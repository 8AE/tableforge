{
  "name": "tableforge",
  "version": "0.1.0",
  "description": "Desktop-ready Dungeons & Dragons table display.",
  "author": "Tableforge",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "host": "vite build && node server.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node server.js",
    "migrate:projects": "node scripts/migrate-project-storage.js",
    "desktop:start": "electron ./desktop/main.js",
    "desktop:build": "electron-builder build --dir",
    "desktop:dist-win": "electron-builder build --win --x64",
    "desktop:dist-mac": "electron-builder build --mac --universal",
    "desktop:dist-linux": "electron-builder build --linux --x64",
    "desktop:dist-all": "electron-builder build -wml --x64"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
